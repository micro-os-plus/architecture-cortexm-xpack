{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2022-2026 Liviu Ionescu. All rights reserved.",
  "cdlComponents": [
    {
      "id": "micro-os-plus.architectures.cortexm",
      "alias": "micro-os-plus.architecture",
      "display": "Cortex-M architecture",
      "description": "The Cortex-M architecture definitions",
      "publicIncludeFolders": [
        "include"
      ],
      "sourceFiles": [
        "src/_init_fini.c",
        "src/semihosting.cpp",
        "src/show-cpuid.cpp"
      ],
      "dependencies": [
        // This introduces a circular dependency.
        // "micro-os-plus.semihosting"
      ],
      "implementedInterfaces": [
        "micro-os-plus.architecture"
      ],
      "generatedFile": {
        "type": "c-header",
        "filePath": "{{buildFolderPath}}/generated/include/micro-os-plus/architecture-defines.h"
      },
      // "defaultDefine": "MICRO_OS_PLUS_INCLUDE_ARCHITECTURES_CORTEXM_ENABLED"
      "cdlComponents": [
        {
          "id": "debugger-entry-point",
          "display": "Debugger entry point",
          "description": "The ELF entry point when the application is started by a debuggger",
          "sourceFiles": [
            "src/debugger-entry-point.S"
          ],
          // "defaultDefine": "MICRO_OS_PLUS_INCLUDE_ARCHITECTURES_CORTEXM_DEBUGGER_ENTRY_POINT_ENABLED"
          "cdlOptions": [
            {
              "id": "initialise-vtor",
              "display": "Initialise VTOR",
              "description": "Initialise the Vector Table Offset Register (VTOR) when the application is started by a debugger",
              // "defaultDefine": "MICRO_OS_PLUS_INCLUDE_ARCHITECTURES_CORTEXM_DEBUGGER_ENTRY_POINT_INITIALISE_VTOR_ENABLED"
            }
          ]
        },
        {
          "id": "reset-handler",
          "display": "Reset handler",
          "description": "The reset handler executed when the system is reset",
          "sourceFiles": [
            "src/reset-handler.c"
          ]
          // "defaultDefine": "MICRO_OS_PLUS_INCLUDE_ARCHITECTURES_CORTEXM_RESET_HANDLER_ENABLED"
        },
        {
          "id": "exception-handlers",
          "display": "Exception handlers",
          "description": "The exception handlers executed when exceptions occur",
          "sourceFiles": [
            "src/exception-handlers.cpp"
          ]
          // "defaultDefine": "MICRO_OS_PLUS_INCLUDE_ARCHITECTURES_CORTEXM_EXCEPTION_HANDLERS_ENABLED"
        }
      ]
    }
  ]
}