            </field>
            <field>
              <name>PRIGROUP</name>
              <description>Interrupt priority grouping</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>BFHFNMINS</name>
              <description>BusFault/HardFault/NMI target Non-secure state when set -- Security Extension only</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PRIS</name>
              <description>Prioritize Secure exceptions -- Security Extension only</description>
              <bitOffset>14</bitOffset>
