              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLEEPDEEPS</name>
              <description>SLEEPDEEP usable from Non-secure state -- Security Extension only</description>
              <bitOffset>3</bitOffset>
