          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RELOAD</name>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>VAL</name>
          <description>SysTick Current Value Register. Any write clears it to 0 and clears COUNTFLAG.</description>
          <addressOffset>0x8</addressOffset>
