            <field>
              <name>PRI_N3</name>
              <description>Priority, byte offset 3</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IPR1</name>
